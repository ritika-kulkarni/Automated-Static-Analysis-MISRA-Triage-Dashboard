{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Polyspace Bug Finder",
          "rules": [
            {
              "id": "MISRA C:2012 Rule-9.1",
              "defaultConfiguration": { "level": "error" },
              "properties": { "category": "mandatory", "tags": ["security", "ASIL-D"] }
            },
            {
              "id": "MISRA C:2012 Rule-8.4",
              "defaultConfiguration": { "level": "warning" },
              "properties": { "category": "required", "tags": ["maintainability"] }
            },
            {
              "id": "MISRA C:2012 Dir-4.1",
              "defaultConfiguration": { "level": "error" },
              "properties": { "category": "mandatory" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "MISRA C:2012 Rule-9.1",
          "level": "error",
          "message": { "text": "The value of an object with automatic storage duration shall not be read before it has been set (Mandatory)." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/app/brake/BrakeCtrl.c" },
                "region": { "startLine": 42, "startColumn": 5 }
              }
            }
          ],
          "properties": { "tags": ["ASIL-D"] }
        },
        {
          "ruleId": "MISRA C:2012 Rule-8.4",
          "level": "warning",
          "message": { "text": "A compatible declaration shall be visible when an object or function with external linkage is defined." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/bsw/can/CanIf.c" },
                "region": { "startLine": 18, "startColumn": 1 }
              }
            }
          ]
        },
        {
          "ruleId": "MISRA C:2012 Dir-4.1",
          "level": "error",
          "message": { "text": "Run-time failures shall be minimized (Mandatory)." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/bsw/nvm/NvM_Read.c" },
                "region": { "startLine": 77, "startColumn": 3 }
              }
            }
          ],
          "properties": { "tags": ["ASIL-C"] }
        }
      ]
    }
  ]
}
